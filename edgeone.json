{
  "headers": [
    {
      "source": "/fonts/fontawesome-webfont.*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET"
        },
        {
          "key": "Vary",
          "value": "Origin"
        }
      ]
    },
    {
      "source": "/img/Sakura/linecat/*.ani",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type", // 添加 MIME 类型
          "value": "application/x-navi-animation" // 标准 .ani MIME 类型
        }
      ]
    }
  ]
}
